{
  "private": true,
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@eslint/js": "10.0.1",
    "@girs/clutter-18": "5.6.0",
    "@girs/gio-2.0": "5.6.0",
    "@girs/gjs": "5.6.0",
    "@girs/glib-2.0": "5.6.0",
    "@girs/gnome-shell": "51.0.1",
    "@girs/meta-18": "5.6.0",
    "@girs/shell-18": "5.6.0",
    "@girs/st-18": "5.6.0",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-instrument": "1.7.8",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.1"
  },
  "scripts": {
    "format": "cd .. && gnome/node_modules/.bin/biome format --write .",
    "format:check": "cd .. && gnome/node_modules/.bin/biome format .",
    "lint": "(cd .. && gnome/node_modules/.bin/biome lint --error-on-warnings .) && eslint extension eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "check": "(cd .. && gnome/node_modules/.bin/biome check --error-on-warnings .) && eslint extension eslint.config.mjs --max-warnings 0 && npm run typecheck"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
